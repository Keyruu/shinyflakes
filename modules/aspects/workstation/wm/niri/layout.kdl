layout {
    shadow {
        on
    }

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.666
        proportion 1.0
    }

    default-column-width { proportion 1.0; }

    always-center-single-column
    center-focused-column "on-overflow"

    struts {
        left 12
        right 12
        top 0
        bottom 0
    }
}
